# ==============================================================================
# BN GAMEEX — GLOBAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Ref: Master PO Order BN-GAMEEX-MASTER-001
# ==============================================================================

# 1. API SERVER & NETWORKING
PORT=8080
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://gameex.bookingnetwork.example,https://admin.bookingnetwork.example
API_BASE_URL=https://api.bookingnetwork.example/api/v1
WS_BASE_URL=wss://api.bookingnetwork.example/api/v1/ws/chat

# 2. POSTGRESQL MASTER DATABASE
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<mode>
DATABASE_URL=postgres://gameex_user:change_this_to_strong_prod_password@postgres:5432/bn_gameex?sslmode=disable
AUTO_MIGRATE=true
MIGRATION_PATH=database/migrations/001_initial_schema.sql
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s

# 3. REDIS CACHE & PUBSUB
REDIS_URL=redis://redis:6379/0

# 4. SECURITY & AUTHENTICATION
JWT_SECRET=change_to_64_character_cryptographically_secure_random_hex_string
JWT_EXPIRATION_HOURS=24
MFA_ENFORCED_FOR_ADMIN=true

# 5. PAYMENT SERVICE PROVIDER (PSP) ADAPTER
# Note: For production live trading, merchant acquiring contract must be countersigned.
PSP_PROVIDER_ID=stripe_sandbox
PSP_WEBHOOK_SECRET=whsec_change_this_to_licensed_psp_webhook_secret_key
PSP_SANDBOX_MODE=true

# 6. OBJECT STORAGE (S3 COMPATIBLE)
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=bn-gameex-delivery-evidence-prod
S3_ACCESS_KEY_ID=change_to_iam_access_key
S3_SECRET_ACCESS_KEY=change_to_iam_secret_key
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# 7. FEATURE FLAGS & SAFETY KILL-SWITCHES
CHECKOUT_ENABLED=true
PAYOUTS_ENABLED=false # Must remain false until PO explicit commercial authorization
GAME_CURRENCY_TRADE_ENABLED=false # Gated per Korean Game Industry Act & AML policy
GAME_ACCOUNT_TRADE_ENABLED=false # Strictly prohibited in v1.0 per Article 3.4

